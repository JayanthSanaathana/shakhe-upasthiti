MONGO_URI=
# Read-only live entities/hierarchy/roles DB (kdpEntities). Never written by this app.
# If unset, those reads fall back to MONGO_URI.
ENTITY_MONGO_URI=
# local (default) uses the cached hierarchy/roles collections; live uses ENTITY_MONGO_URI.
ENTITY_REFERENCE_SOURCE=local
ENTITY_LOCAL_HIERARCHY_OVERRIDE=false
# Comma-separated Nagars whose local display names are preserved during sync.
# Membership and parent links come from live data. Example: JALAHALLI
ENTITY_LOCAL_HIERARCHY_OVERRIDE_NAMES=
ENTITY_CACHE_SYNC_INTERVAL_MINUTES=1440
# Optional SOCKS5 for external read-only Mongo connections. Set automatically by the
# production entrypoint when SSH or Tailscale egress is enabled.
# Example: 127.0.0.1:1055
MONGO_SOCKS_PROXY=
# Preferred static egress: restricted SSH tunnel through the AWS server.
SSH_EGRESS_HOST=
SSH_EGRESS_USER=railway-egress
SSH_EGRESS_PRIVATE_KEY_B64=
SSH_EGRESS_KNOWN_HOSTS_B64=
# Tailscale (production image). Leave unset for local direct Atlas access.
# Kept as a legacy fallback when SSH_EGRESS_PRIVATE_KEY_B64 is unset.
TS_AUTHKEY=
TS_EXIT_NODE=
TS_HOSTNAME=shakhe-upasthiti
TS_EXPECTED_EGRESS_IP=
SHAKHE_PORT=3002
AUTH_SERVICE_URL=https://auth-server-odsk.onrender.com
NAGARA_SESSION_SECRET=
VARADI_SESSION_SECRET=
PHONE_SESSION_SECRET=
