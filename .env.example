MONGO_URI=
# Read-only live people/entities/roles DB (kdpEntities). Never written by this app.
# If unset, those reads fall back to MONGO_URI.
ENTITY_MONGO_URI=
# Optional SOCKS5 for ENTITY_MONGO_URI only (Tailscale userspace on Railway).
# Example: 127.0.0.1:1055
MONGO_SOCKS_PROXY=
# Tailscale (production image). Leave unset for local direct Atlas access.
TS_AUTHKEY=
TS_EXIT_NODE=
TS_HOSTNAME=shakhe-upasthiti
SHAKHE_PORT=3002
AUTH_SERVICE_URL=https://auth-server-odsk.onrender.com
NAGARA_SESSION_SECRET=
VARADI_SESSION_SECRET=
PHONE_SESSION_SECRET=
